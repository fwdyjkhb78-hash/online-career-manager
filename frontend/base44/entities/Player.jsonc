{
  "name": "Player",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du joueur"
    },
    "position": {
      "type": "string",
      "enum": [
        "GK",
        "CB",
        "LB",
        "RB",
        "CDM",
        "CM",
        "CAM",
        "LW",
        "RW",
        "ST"
      ]
    },
    "club_id": {
      "type": "string"
    },
    "club_name": {
      "type": "string"
    },
    "overall": {
      "type": "number"
    },
    "potential": {
      "type": "number"
    },
    "pace": {
      "type": "number"
    },
    "shooting": {
      "type": "number"
    },
    "passing": {
      "type": "number"
    },
    "dribbling": {
      "type": "number"
    },
    "defending": {
      "type": "number"
    },
    "physical": {
      "type": "number"
    },
    "value": {
      "type": "number"
    },
    "age": {
      "type": "number"
    },
    "nationality": {
      "type": "string"
    },
    "height": {
      "type": "number"
    },
    "weight": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "is_on_transfer_list": {
      "type": "boolean",
      "default": false
    },
    "is_on_loan_list": {
      "type": "boolean",
      "default": false,
      "description": "Joueur disponible pour un pr\u00eat"
    },
    "asking_price": {
      "type": "number"
    },
    "loan_asking_price": {
      "type": "number",
      "description": "Frais de pr\u00eat demand\u00e9s par le club"
    },
    "release_clause": {
      "type": "number"
    },
    "is_academy": {
      "type": "boolean",
      "default": false
    },
    "is_suspended": {
      "type": "boolean",
      "default": false
    },
    "suspension_reason": {
      "type": "string"
    },
    "player_role": {
      "type": "string",
      "enum": [
        "espoir",
        "reserviste",
        "rotation",
        "important",
        "titulaire_indiscutable"
      ],
      "default": "rotation"
    },
    "player_details": {
      "type": "string"
    },
    "avg_rating": {
      "type": "number",
      "default": 0
    },
    "rating_count": {
      "type": "number",
      "default": 0
    },
    "centres": {
      "type": "number"
    },
    "finition": {
      "type": "number"
    },
    "precision_tete": {
      "type": "number"
    },
    "passes_courtes": {
      "type": "number"
    },
    "volees": {
      "type": "number"
    },
    "aptitude": {
      "type": "number"
    },
    "mauvais_pied": {
      "type": "number"
    },
    "tacles_debout": {
      "type": "number"
    },
    "tacles_glisses": {
      "type": "number"
    },
    "dribbles": {
      "type": "number"
    },
    "effet": {
      "type": "number"
    },
    "precision_cf": {
      "type": "number"
    },
    "passes_longues": {
      "type": "number"
    },
    "conduite_balle": {
      "type": "number"
    },
    "puissance_tir": {
      "type": "number"
    },
    "detente": {
      "type": "number"
    },
    "endurance": {
      "type": "number"
    },
    "force": {
      "type": "number"
    },
    "tirs_loin": {
      "type": "number"
    },
    "acceleration": {
      "type": "number"
    },
    "vitesse_sprint": {
      "type": "number"
    },
    "agilite": {
      "type": "number"
    },
    "reactivite": {
      "type": "number"
    },
    "equilibre": {
      "type": "number"
    },
    "agressivite": {
      "type": "number"
    },
    "interception": {
      "type": "number"
    },
    "positionnement": {
      "type": "number"
    },
    "vista": {
      "type": "number"
    },
    "penaltys": {
      "type": "number"
    },
    "plongeon": {
      "type": "number"
    },
    "jeu_a_la_main": {
      "type": "number"
    },
    "degagement": {
      "type": "number"
    },
    "reflexe_g": {
      "type": "number"
    },
    "boost_overall": {
      "type": "number",
      "default": 0
    },
    "boost_base_overall": {
      "type": "number"
    },
    "boost_journees_restantes": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "position",
    "overall"
  ]
}