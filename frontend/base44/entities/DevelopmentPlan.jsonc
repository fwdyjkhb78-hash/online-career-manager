{
  "name": "DevelopmentPlan",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string"
    },
    "club_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "budget_allocated": {
      "type": "number",
      "default": 0
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "published_at": {
      "type": "string"
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "club_id",
    "title"
  ]
}