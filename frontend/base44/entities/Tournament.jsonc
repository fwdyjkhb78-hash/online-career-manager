{
  "name": "Tournament",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du tournoi"
    },
    "description": {
      "type": "string",
      "description": "Description du tournoi"
    },
    "championship_slug": {
      "type": "string",
      "description": "Slug du championnat auquel ce tournoi est li\u00e9 (pour affichage dans l'onglet Classement)"
    },
    "tournament_type": {
      "type": "string",
      "enum": [
        "championnat",
        "tableau",
        "poules",
        "coupe",
        "poules_tableau",
        "ldc",
        "chapeaux_ldc"
      ],
      "default": "tableau",
      "description": "Format du tournoi"
    },
    "ldc_config": {
      "type": "object",
      "description": "Configuration compl\u00e8te Ligue des Champions",
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "qualification",
            "league",
            "playoff",
            "knockout",
            "finished"
          ],
          "default": "qualification",
          "description": "Phase actuelle du tournoi"
        },
        "qualification_format": {
          "type": "string",
          "enum": [
            "poules",
            "tableau",
            "aller_retour"
          ],
          "default": "tableau",
          "description": "Format des tours de qualification"
        },
        "league_team_count": {
          "type": "number",
          "default": 32,
          "description": "Nombre total d'\u00e9quipes en phase de championnat"
        },
        "league_matches_per_team": {
          "type": "number",
          "default": 8,
          "description": "Nombre de matchs que chaque \u00e9quipe joue en phase de championnat"
        },
        "league_direct_qualification_spots": {
          "type": "number",
          "default": 8,
          "description": "Nombre d'\u00e9quipes qualifi\u00e9es directement pour les finales"
        },
        "playoff_team_count": {
          "type": "number",
          "default": 16,
          "description": "Nombre d'\u00e9quipes en barrages (9-24)"
        },
        "knockout_format": {
          "type": "string",
          "enum": [
            "8",
            "16",
            "32"
          ],
          "default": "8",
          "description": "Nombre d'\u00e9quipes en phase finale (quarts, demis, finale)"
        },
        "is_two_legged": {
          "type": "boolean",
          "default": true,
          "description": "Matchs aller-retour (sauf finale)"
        }
      }
    },
    "team_count": {
      "type": "number",
      "default": 8,
      "description": "Nombre d'\u00e9quipes participantes"
    },
    "participating_club_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs des clubs participants"
    },
    "participating_club_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Noms des clubs participants"
    },
    "group_count": {
      "type": "number",
      "default": 2,
      "description": "Nombre de groupes (pour phase de poules)"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "group_name": {
            "type": "string"
          },
          "club_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "club_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "default": [],
      "description": "Groupes de la phase de poules"
    },
    "chapeau_config": {
      "type": "object",
      "description": "Configuration sauvegard\u00e9e des chapeaux LDC (chapeauCount, chapeaux, chapeauxMatchCount, chapeauxKoCount)",
      "default": null
    },
    "knockout_generated": {
      "type": "boolean",
      "default": false,
      "description": "La phase \u00e9liminatoire a-t-elle \u00e9t\u00e9 g\u00e9n\u00e9r\u00e9e ?"
    },
    "league_journee_count": {
      "type": "number",
      "description": "Nombre de journ\u00e9es de la phase de ligue (pour LDC/chapeaux) \u2014 s\u00e9pare la phase KO"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "ongoing",
        "finished"
      ],
      "default": "upcoming"
    },
    "prize_1st": {
      "type": "number",
      "default": 0
    },
    "prize_2nd": {
      "type": "number",
      "default": 0
    },
    "prize_3rd": {
      "type": "number",
      "default": 0
    },
    "winner_club_id": {
      "type": "string"
    },
    "winner_club_name": {
      "type": "string"
    },
    "second_club_id": {
      "type": "string"
    },
    "second_club_name": {
      "type": "string"
    },
    "third_club_id": {
      "type": "string"
    },
    "third_club_name": {
      "type": "string"
    },
    "results_text": {
      "type": "string",
      "description": "R\u00e9sultats d\u00e9taill\u00e9s"
    },
    "rewards_distributed": {
      "type": "boolean",
      "default": false
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}